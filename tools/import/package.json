{
  "name": "pelagic-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scans a local FLAC library and syncs it (FLAC + Opus phone copies + covers + catalogue) to Google Drive for Pelagic.",
  "engines": { "node": ">=20" },
  "scripts": {
    "import": "node src/import.js",
    "dry-run": "node src/import.js --dry-run"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^185.0.0",
    "music-metadata": "^12.2.0"
  }
}
