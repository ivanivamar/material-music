<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen widget (design_handoff_android_widget): one resizable "Now playing" widget, 1×1 up
    to 4×4, default 4×2. The layout follows the size (WidgetRenderer.modeOf). Updates come from the
    player service on every change; the 30 min period only refreshes the idle greeting.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/wg_description"
    android:initialLayout="@layout/widget_idle_grid"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="420dp"
    android:previewImage="@drawable/wg_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
