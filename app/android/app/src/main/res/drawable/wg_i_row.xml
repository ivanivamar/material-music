<?xml version="1.0" encoding="utf-8"?>
<!-- Idle widget recents row: transparent, pressed = high (radius 12) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/wg_i_high">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
