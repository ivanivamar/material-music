<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 3×2+ / 4×2+, nothing playing (iGrid): one or two rows of three quick-start cards
    (Resume · DJ · Daily mix 1, plus Radio · Daily mix 2 · Rediscover at 4 rows) and Shuffle library.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/wg_grid1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/wg_grid2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wg_gap2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wg_shuffle_all"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="@string/wg_shuffle_library"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wg_shuffle_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wg_shuffle_ic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wg_shuffle" />

                <TextView
                    android:id="@+id/wg_shuffle_text"
                    style="@style/WgText.Medium"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/wg_shuffle_library"
                    android:textSize="16dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
