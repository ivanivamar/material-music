<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 3×2+ / 4×2+, nothing playing: mark + NOTHING PLAYING (+ greeting from 3 rows), a row of
    three square picks (Resume · DJ · Daily Mix 1; two rows at 4 rows: + radio, Daily Mix 2,
    Rediscover — widget_idle_pick), and Shuffle library from 3 rows.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:layout_marginStart="-5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/WgMono"
                    android:letterSpacing="0.16"
                    android:text="NOTHING PLAYING" />

                <TextView
                    android:id="@+id/wg_greeting"
                    style="@style/WgText"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="-0.015"
                    android:textSize="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="10dp" />

        <LinearLayout
            android:id="@+id/wg_grid1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/wg_grid2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wg_gap2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wg_shuffle_all"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/wg_row_bg"
            android:contentDescription="@string/wg_shuffle_library"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_shuffle"
                android:tint="@color/wg_text" />

            <TextView
                style="@style/WgText"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/wg_shuffle_library"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/wg_songs"
                style="@style/WgMono" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
