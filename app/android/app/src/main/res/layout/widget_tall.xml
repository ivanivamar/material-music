<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 3×3+ / 4×3+ (player + queue): cover 88 + status / title / artist, scrubber + times,
    shuffle · prev · play 52 · next · repeat, then the next rows of the queue (widget_queue_row).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wg_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wg_eq"
                    android:layout_width="8.5dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wg_eq" />

                <TextView
                    android:id="@+id/wg_label"
                    style="@style/WgMono" />
            </LinearLayout>

                <TextView
                    android:id="@+id/wg_title"
                    style="@style/WgText"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="-0.015"
                    android:textSize="22dp" />

                <TextView
                    android:id="@+id/wg_artist"
                    style="@style/WgText.Muted"
                    android:layout_marginTop="6dp"
                    android:textSize="14dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/wg_scrub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-10dp"
            android:layout_marginBottom="-6dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/wg_pos"
                style="@style/WgMono"
                android:letterSpacing="0"
                android:textSize="10dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/wg_dur"
                style="@style/WgMono"
                android:letterSpacing="0"
                android:textSize="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wg_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/wg_shuffle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_shuffle"
                android:tint="@color/wg_text" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wg_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/wg_prev"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_prev"
                android:tint="@color/wg_text" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wg_play"
                style="@style/WgPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="16dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wg_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/wg_next"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_next"
                android:tint="@color/wg_text" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wg_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/wg_repeat"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_repeat"
                android:tint="@color/wg_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_queue_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/wg_hair" />

            <LinearLayout
                android:id="@+id/wg_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
