<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2+, nothing playing: mark + NOTHING PLAYING, greeting, Resume …, play + DJ pill -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:layout_marginStart="-5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wg_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/WgMono"
                    android:letterSpacing="0.16"
                    android:text="NOTHING PLAYING" />

                <TextView
                    android:id="@+id/wg_greeting"
                    style="@style/WgText"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="-0.015"
                    android:textSize="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wg_title"
            style="@style/WgText"
            android:letterSpacing="-0.01"
            android:textSize="17dp" />

        <TextView
            android:id="@+id/wg_sub"
            style="@style/WgText.Muted"
            android:layout_marginTop="3dp"
            android:textSize="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wg_play"
                style="@style/WgPlay" />

            <LinearLayout
                android:id="@+id/wg_dj"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="@drawable/wg_dj_pill"
                android:contentDescription="@string/wg_start_dj"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wg_dj_dot" />

                <TextView
                    style="@style/WgMono"
                    android:letterSpacing="0.16"
                    android:text="DJ"
                    android:textColor="@color/wg_lilac"
                    android:textSize="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
