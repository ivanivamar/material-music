<?xml version="1.0" encoding="utf-8"?>
<!-- Widget queue row (mPlayer + hasUp): art 36 (radius 8), title 14, artist 12. Tap = play it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_row"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/wg_row_art"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wg_row_title"
            style="@style/WgText.Medium"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/wg_row_artist"
            style="@style/WgText.Muted"
            android:layout_marginTop="1dp"
            android:textSize="12dp" />
    </LinearLayout>
</LinearLayout>
