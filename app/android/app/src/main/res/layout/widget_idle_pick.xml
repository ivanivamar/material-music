<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-start card on the idle grid: card bg + top art (or DJ knob) as one bitmap, title and sub at bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/wg_pick_gap"
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/wg_pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/wg_pick_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wg_pick_title"
                style="@style/WgText.Medium"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/wg_pick_sub"
                style="@style/WgText.Muted"
                android:layout_width="match_parent"
                android:textSize="11dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
