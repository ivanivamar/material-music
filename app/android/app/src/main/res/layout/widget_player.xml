<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget 3×2 / 4×2 (mPlayer, default size): cover 144, (knob) status, title, artist,
    4dp progress bar, prev · play 64×48 · next · shuffle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/wg_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wg_knob"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/wg_label"
                    style="@style/WgLabel" />
            </LinearLayout>

            <TextView
                android:id="@+id/wg_title"
                style="@style/WgText.Medium"
                android:layout_marginTop="2dp"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/wg_artist"
                style="@style/WgText.Muted"
                android:layout_marginTop="2dp"
                android:textSize="14dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wg_scrub"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wg_prev"
                    style="@style/WgIconBtn"
                    android:contentDescription="@string/wg_prev"
                    android:src="@drawable/ic_wg_prev" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/wg_play"
                    style="@style/WgPlay"
                    android:layout_width="64dp"
                    android:layout_height="48dp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/wg_next"
                    style="@style/WgIconBtn"
                    android:contentDescription="@string/wg_next"
                    android:src="@drawable/ic_wg_next" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/wg_shuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wg_shuffle"
                    android:scaleType="fitXY" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
